# Copy to .env (same folder; server.ps1 -Init does it) and fill in. .env is never committed.
# Lines are NAME=value, no quotes.

# The site's Firebase project and who may sign in (Firebase console > Authentication > Users).
FIREBASE_PROJECT_ID=
ALLOWED_UIDS=
ALLOWED_ORIGINS=https://latestavenue.com,https://www.latestavenue.com

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel > install command:
# the long string after --token). Anyone with it can serve as the tunnel: keep it secret.
TUNNEL_TOKEN=

# Random secrets the services share inside the PC. Make each one with:
#   powershell -c "[guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')"
WORKER_KEY=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=latest-avenue

# Where projects, media, renders and models live on the PC: the same folder the single
# container used (install.ps1's -DataDir), so nothing moves. Forward slashes are fine.
DATA_DIR=C:/Users/YOU/latest-avenue-edit-data

# Optional.
# VSE_VERSION=      (default: the version the image was built with)
TZ=Europe/London
BACKUP_HOUR=3
# EDIT_IMAGE=latest-avenue-edit:local   (what install.ps1 builds)
# LLM_THREADS=4
# GATEWAY_PORT=8080
# WORKER_CONCURRENCY=1
