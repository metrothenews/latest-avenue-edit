# Copy to .env (same folder; server.ps1 -Init does it) and fill in. .env is never committed.
# Lines are NAME=value, no quotes. This file holds every secret the PC has; nothing else does.

# The site's Firebase project and who may sign in (Firebase console > Authentication > Users).
FIREBASE_PROJECT_ID=
ALLOWED_UIDS=
ALLOWED_ORIGINS=https://latestavenue.com,https://www.latestavenue.com

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel > install command:
# the long string after --token). Anyone with it can serve as the tunnel: keep it secret.
TUNNEL_TOKEN=
COMPOSE_PROFILES=tunnel

# Pulling the released image from GitHub's registry (private): a GitHub user name and a
# token that can only read packages (classic token, scope read:packages; SERVER.md, step 3).
GHCR_USER=
GHCR_TOKEN=
EDIT_IMAGE=ghcr.io/metrothenews/latest-avenue-edit:stable

# The heartbeat's Google service account key, base64-encoded on one line (SERVER.md, step 6).
# Empty: no heartbeat (the site then only has /status to go on).
HEARTBEAT_SA_B64=

# Random secrets the services share inside the PC (server.ps1 -Init makes them). By hand:
#   powershell -c "[guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')"
WORKER_KEY=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=latest-avenue

# 1 when the PC has an NVIDIA card (server.ps1 -Init sets it): transcription uses it.
USE_GPU=0

# Optional.
TZ=Europe/London
BACKUP_HOUR=3
# UPDATE_INTERVAL=300        seconds between checks for a new release
# UPDATE_IDLE_WAIT=7200      an update waits up to this long for nobody to be editing
# UPDATE_DISABLED=1          stop automatic updates (the admin page's "update" still works)
# LLM_THREADS=4
# GATEWAY_PORT=8080
# WORKER_CONCURRENCY=1
